# Portal Azure > IoT Hub > Hub settings > Built-in endpoints > Event Hub compatible endpoint (cadena completa)
EVENTHUB_COMPATIBLE_CONNECTION_STRING="Endpoint=sb://<ns>.servicebus.windows.net/;SharedAccessKeyName=service;SharedAccessKey=<clave>;EntityPath=<hub>"
# Opcional: grupo de consumidores (por defecto $Default)
EVENTHUB_CONSUMER_GROUP="$Default"
