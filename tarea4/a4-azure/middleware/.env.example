# Cadena de conexión DEL DISPOSITIVO (portal Azure > IoT Hub > Devices > <device> > Primary connection string)
AZURE_DEVICE_CONNECTION_STRING="HostName=<hub>.azure-devices.net;DeviceId=contiki-ng-01;SharedAccessKey=<clave>"
# URL HTTP del mote (IPv6 entre corchetes). Con TARGET=native en el contenedor es esta:
SENSOR_URL="http://[fd00::302:304:506:708]/"
# Opcional: periodo de consulta en ms (3000 por defecto, como en Kurniawan)
POLL_MS=3000
